    "husky": "9.1.7",
    "jsonc-eslint-parser": "2.4.0",
    "nx": "21.3.7",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.6.2",
    "syncpack": "13.0.4",
