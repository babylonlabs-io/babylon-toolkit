{
  "name": "@babylonlabs-io/ts-sdk",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "tags": ["type:package"],
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "test-browser": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm test-browser",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "test": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm test:built",
        "cwd": "{projectRoot}"
      },
      "cache": true
    }
  }
}
