{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "module": "esnext",
    // tsx resolves like a bundler: `nx` is CommonJS with no "exports" map, so
    // `nx/release` only resolves through directory-index lookup.
    "moduleResolution": "bundler",
    "noEmit": true,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
