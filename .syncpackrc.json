{
  "customTypes": {
    "optional": {
      "strategy": "versionsByName",
      "path": "optionalDependencies"
    }
  },
  "versionGroups": [
    {
      "label": "Installed dependencies and overrides must be an exact version or workspace:*",
      "dependencyTypes": [
        "prod",
        "dev",
        "optional",
        "pnpmOverrides"
      ],
      "specifierTypes": [
        "!exact",
        "!workspace-protocol"
      ],
      "isBanned": true
    },
    {
      "label": "Decoupled SDK packages use pinned npm versions in consumers",
      "dependencies": [
        "@babylonlabs-io/ts-sdk",
        "@babylonlabs-io/babylon-tbv-rust-wasm"
      ],
      "dependencyTypes": [
        "!local"
      ],
      "isIgnored": true
    },
    {
      "label": "Local packages must be referenced with *",
      "dependencies": [
        "$LOCAL"
      ],
      "dependencyTypes": [
        "!local"
      ],
      "pinVersion": "workspace:*"
    },
    {
      "label": "Peer ranges declare consumer compatibility and are not compared with our exact pins",
      "dependencyTypes": [
        "peer"
      ],
      "isIgnored": true
    }
  ]
}
