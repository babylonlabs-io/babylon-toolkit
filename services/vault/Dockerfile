FROM node:24.21.0-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build

ENV HUSKY=0 \
    CI=true \
    NX_DAEMON=false \
    NX_NO_CLOUD=true \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0

WORKDIR /src

RUN corepack enable

COPY . .

RUN pnpm install --frozen-lockfile

ARG NEXT_PUBLIC_TBV_NETWORK
ARG NEXT_PUBLIC_ETH_RPC_URL
ARG NEXT_PUBLIC_MEMPOOL_API
ARG NEXT_PUBLIC_TBV_VP_EXPLORER_URL
ARG NEXT_PUBLIC_TBV_SIDECAR_API_URL
ARG NEXT_PUBLIC_TBV_ORDINALS_API_URL
ARG NEXT_PUBLIC_TBV_UTILS_API
ARG NEXT_PUBLIC_COMMIT_HASH
ARG NEXT_PUBLIC_CANONICAL
ARG NEXT_PUBLIC_REOWN_PROJECT_ID
ARG NEXT_PUBLIC_SENTRY_DSN
ARG NEXT_PUBLIC_SENTRY_TUNNEL_URL
ARG NEXT_PUBLIC_RELEASE_ID
ARG NEXT_PUBLIC_DIST_ID
ARG NEXT_PUBLIC_SENTRY_ENVIRONMENT
ARG NEXT_PUBLIC_FF_DISABLE_VAULT_CAP
ARG NEXT_PUBLIC_FF_ENABLE_LEDGER_VAULT_WALLET
ARG NEXT_PUBLIC_FF_ENABLE_EXPLORE
ARG NEXT_PUBLIC_FF_ENABLE_MOBILE
ARG NEXT_PUBLIC_FF_DISABLE_DEPOSIT
ARG NEXT_PUBLIC_FF_DISABLE_BORROW
ARG NEXT_PUBLIC_FF_PROTOCOL_FROZEN
ARG NEXT_PUBLIC_FF_PROTOCOL_PAUSED
ARG NEXT_PUBLIC_FF_FORCE_PARTIAL_LIQUIDATION_SPLIT
ARG NEXT_PUBLIC_TBV_DISABLED_BTC_WALLETS
ARG NEXT_PUBLIC_NOTICE_BANNER_MESSAGE

RUN NODE_OPTIONS=--max-old-space-size=8192 pnpm exec nx run @services/vault:build \
    && pnpm --filter @services/vault run check:built-profile "$NEXT_PUBLIC_TBV_NETWORK" \
    && find services/vault/dist -type f -name '*.map' -delete

FROM nginxinc/nginx-unprivileged:1.30.5-alpine@sha256:56b8272e43a0525f67aed68d1e0794a712d10e3e45a563e118e9a77c817e6f86

COPY services/vault/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/services/vault/dist /usr/share/nginx/html

USER 101

EXPOSE 8080

ENTRYPOINT ["nginx", "-g", "daemon off;"]
