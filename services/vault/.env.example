# Bitcoin Network (REQUIRED)
# Must be "mainnet" or "signet"
# Use "signet" for devnet/testnet, "mainnet" for production
NEXT_PUBLIC_BTC_NETWORK=signet

# Bitcoin Mempool API (optional) — the mempool HOST only, WITHOUT the /signet
# path or a trailing /api. For signet, /signet is appended from
# NEXT_PUBLIC_BTC_NETWORK and /api by the reader (-> https://mempool.space/signet/api);
# mainnet stays at the host root. Point it at a CORS-enabled proxy in your own
# .env if mempool.space blocks local requests.
NEXT_PUBLIC_MEMPOOL_API=https://mempool.space

# Ethereum Chain ID (REQUIRED)
# Must be "1" (mainnet) or "11155111" (sepolia)
# Use "11155111" for devnet/testnet, "1" for production
NEXT_PUBLIC_ETH_CHAINID=11155111

# Ethereum RPC URL (optional, has defaults per chain ID)
NEXT_PUBLIC_ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Vault Services
NEXT_PUBLIC_TBV_GRAPHQL_ENDPOINT=https://babylon-vault-indexer-api.vault-devnet.babylonlabs.io
NEXT_PUBLIC_TBV_VP_PROXY_URL=https://vault-provider-proxy-api.vault-devnet.babylonlabs.io
# Utils API (optional). Local-only — not synced from tbv-networks; set per deployment.
NEXT_PUBLIC_TBV_UTILS_API=https://utils-api.vault-devnet.babylonlabs.io

# Babylon BTC Vault block explorer (optional)
# Base URL for the explorer; hosts /provider/<addr>, /vault/<id>, /depositor/<addr>.
# The vault provider picker links each VP row to <base>/provider/<vp-address>.
# Defaults to the public testnet host; override for mainnet builds.
NEXT_PUBLIC_TBV_VP_EXPLORER_URL=https://babylon-btcvault-testnet.explorer.xangle.io

# Ordinals API (optional)
# Used as fallback for inscription detection when wallet doesn't support getInscriptions().
# If not set, the app will rely solely on wallet's native inscription detection.
# NEXT_PUBLIC_TBV_ORDINALS_API_URL=https://your-ordinals-api.example.com

# Trustless Bitcoin Vault (TBV) Contracts
NEXT_PUBLIC_TBV_BTC_VAULT_REGISTRY=0x4DE2ca497104dF6245e0348755b673ff430A23Be
NEXT_PUBLIC_TBV_AAVE_ADAPTER=0x7ef26BEDB2fa76cdfBb8E747202bF086eC9053DD
NEXT_PUBLIC_TBV_AAVE_ADAPTER_CONFIG=0xC89A41e473951cCB9A114B8f7908E2906E2950fd
# Reown (WalletConnect) project ID for wallet integration
NEXT_PUBLIC_REOWN_PROJECT_ID=your-reown-project-id-here

# Sidecar API URL (optional, for provider logos)
# Leave blank to disable logo fetching; set per deployment to the
# sidecar host for that environment.
# NEXT_PUBLIC_TBV_SIDECAR_API_URL=

# Local development only. The sidecar sends no CORS headers for http://localhost, so
# calling it directly from `pnpm dev` fails preflight and logos stay blank. Set
# SIDECAR_PROXY_TARGET to the sidecar host and NEXT_PUBLIC_TBV_SIDECAR_API_URL to the dev
# server's /sidecar prefix, and the dev server proxies the call so it stays same-origin.
# Leave both unset to call the sidecar directly (the deployed behaviour).
# SIDECAR_PROXY_TARGET=https://sidecar-api.<env>.babylonlabs.io
# NEXT_PUBLIC_TBV_SIDECAR_API_URL=http://localhost:5173/sidecar

# Feature Flags (all default to disabled; set to "true" to enable)
# Kill-switch for the vault supply-cap UI (dashboard section + deposit-form validation).
# When enabled, the CapPolicy contract is never read. Vault cap is on by default.
# NEXT_PUBLIC_FF_DISABLE_VAULT_CAP=true
# Enables the flat v3 page routes while keeping v2 as the default.
# NEXT_PUBLIC_FF_ENABLE_V3_UI=true
# Dev/QA only (dev builds only — hard-gated on import.meta.env.DEV, stripped from production).
# Floating "god mode" admin panel for injecting UI states (mock deposits/withdrawals/collateral).
# NEXT_PUBLIC_FF_GOD_MODE_PANEL=true
# Adds the position-notifications debug controls as a section INSIDE the god-mode panel, for testing
# notification scenarios. Requires NEXT_PUBLIC_FF_GOD_MODE_PANEL and NEXT_PUBLIC_FF_ENABLE_LIQUIDATION_NOTIFICATIONS.
# NEXT_PUBLIC_FF_POSITION_DEBUG_PANEL=true
# Shows the dashboard liquidation-notification banner (health-factor warnings + suggested actions).
# NEXT_PUBLIC_FF_ENABLE_LIQUIDATION_NOTIFICATIONS=true
# Enables browser (desktop) notifications that nudge the depositor to sign when a deposit needs action and they've switched tabs.
# NEXT_PUBLIC_FF_ENABLE_SIGNING_NOTIFICATIONS=true
# Freeze: shows the teal "Protocol is frozen" banner and disables new deposits + borrows (exits like repay/withdraw/liquidation stay available).
# NEXT_PUBLIC_FF_PROTOCOL_FROZEN=true
# Pause: shows the red "Protocol is paused" banner — the full stop. Wins over frozen when both are set.
# NEXT_PUBLIC_FF_PROTOCOL_PAUSED=true
# Optional override for the frozen/paused banner body text; leave unset to use the default per-status copy.
# NEXT_PUBLIC_PROTOCOL_STATUS_MESSAGE=
# Switches the app to the v3 sidebar shell and its per-page routes. Off (the default) keeps today's v2
# header + top-nav dashboard, with the v3-only routes unreachable. Temporary scaffolding for the v3
# rebuild — removed together with the v2 shell once v3 becomes the default.
# NEXT_PUBLIC_FF_ENABLE_V3_UI=true
# Freeform notice banner shown at the top of the app (e.g. for intermittent
# peg-in errors or degraded service). Leave blank to hide. Independent of
# NEXT_PUBLIC_FF_DISABLE_DEPOSIT — a notice can be shown while deposits stay on.
# NEXT_PUBLIC_NOTICE_BANNER_MESSAGE=Peg-ins may be intermittently delayed. Retrying usually resolves it.
# Comma-separated list of BTC wallet IDs to hide from the connect UI, per
# environment. Use it to keep experimental/not-yet-ready wallets out (onekey,
# utila) and to pull a wallet fast if its signing behavior regresses. Any
# environment where an experimental wallet should stay hidden must list it here.
# IDs: unisat, onekey, okx, keystone, utila.
# NEXT_PUBLIC_TBV_DISABLED_BTC_WALLETS=onekey,utila


# Added by sync-env from devnet
NEXT_PUBLIC_TBV_BTC_PRICE_FEED=0xA5c0105B71D9D2CaDC151A1875a5B71C85AbF8DB
