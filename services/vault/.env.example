# Which deployment this build is for. Names a file in networks/<name>.json,
# which carries the Bitcoin network, Ethereum chain, contract addresses and
# service endpoints. Regenerate a profile from tbv-networks with
# `pnpm sync-env <name>`; add a new one with `pnpm sync-env <name> --kind test`.
# The selector must not be set in this or any dotenv file: Nx loads them into the
# build but keys its cache on the process environment, so the build refuses it.
# Pass it on the command line instead: `NEXT_PUBLIC_TBV_NETWORK=<name> pnpm dev`.
# Unset locally means devnet. CI and release builds must set it.

# Ethereum RPC override (optional). The profile carries a default; a deployment
# with its own node sets this. Whichever is used must serve eth_simulateV1: the
# vault activation checks its gas limit with it before sending
# (services/vault/src/services/vault/activationGasLimit.ts).
# NEXT_PUBLIC_ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Bitcoin Mempool API (optional) — the mempool HOST only, WITHOUT the /signet
# path or a trailing /api. For signet, /signet is appended from the profile's
# btcNetwork and /api by the reader (-> https://mempool.space/signet/api);
# mainnet stays at the host root. Point it at a CORS-enabled proxy in your own
# .env if mempool.space blocks local requests.
NEXT_PUBLIC_MEMPOOL_API=https://mempool.space

# Reown (WalletConnect) project ID for wallet integration (required)
NEXT_PUBLIC_REOWN_PROJECT_ID=your-reown-project-id-here

# Utils API (optional). Not in the profile; set per deployment.
NEXT_PUBLIC_TBV_UTILS_API=https://utils-api.vault-devnet.babylonlabs.io

# Babylon BTC Vault block explorer (optional)
# Base URL for the explorer; hosts /provider/<addr>, /vault/<id>, /depositor/<addr>.
# The vault provider picker links each VP row to <base>/provider/<vp-address>.
NEXT_PUBLIC_TBV_VP_EXPLORER_URL=https://babylon-btcvault-testnet.explorer.xangle.io

# Ordinals API (optional)
# Used as fallback for inscription detection when wallet doesn't support getInscriptions().
# If not set, the app will rely solely on wallet's native inscription detection.
# NEXT_PUBLIC_TBV_ORDINALS_API_URL=https://your-ordinals-api.example.com

# Sidecar API URL (optional, for provider logos)
# Leave blank to disable logo fetching; set per deployment to the
# sidecar host for that environment.
# NEXT_PUBLIC_TBV_SIDECAR_API_URL=

# Local development only. The sidecar sends no CORS headers for http://localhost, so
# calling it directly from `pnpm dev` fails preflight and logos stay blank. Set
# SIDECAR_PROXY_TARGET to the sidecar host and NEXT_PUBLIC_TBV_SIDECAR_API_URL to the dev
# server's /sidecar prefix, and the dev server proxies the call so it stays same-origin.
# Leave both unset to call the sidecar directly (the deployed behaviour).
# SIDECAR_PROXY_TARGET=https://sidecar-api.<env>.babylonlabs.io
# NEXT_PUBLIC_TBV_SIDECAR_API_URL=http://localhost:5173/sidecar

# Feature Flags (all default to disabled; set to "true" to enable)
# Kill-switch for the vault supply-cap UI (dashboard section + deposit-form validation).
# When enabled, the CapPolicy contract is never read. Vault cap is on by default.
# NEXT_PUBLIC_FF_DISABLE_VAULT_CAP=true
# Kill-switch to disable deposit functionality during maintenance or incidents.
# NEXT_PUBLIC_FF_DISABLE_DEPOSIT=true
# Kill-switch to disable borrowing functionality during maintenance or incidents.
# NEXT_PUBLIC_FF_DISABLE_BORROW=true
# Shows the Explore section — the /explore page and its sidebar entry. Off until
# the partner list is backed by the contributor registry; with it off the route
# redirects to the overview.
# NEXT_PUBLIC_FF_ENABLE_EXPLORE=true
# Phone experience for the mobile epic (#2580): Continue on Desktop for Bitcoin
# actions and no Bitcoin row in the connect dialog on touch-first devices.
# NEXT_PUBLIC_FF_ENABLE_MOBILE=true
# Dev/QA only (dev builds only — hard-gated on import.meta.env.DEV, stripped from production).
# Floating "god mode" admin panel for injecting UI states (mock deposits/withdrawals/collateral).
# NEXT_PUBLIC_FF_GOD_MODE_PANEL=true
# Adds the position-notifications debug controls as a section INSIDE the god-mode panel, for testing
# notification scenarios. Requires NEXT_PUBLIC_FF_GOD_MODE_PANEL.
# NEXT_PUBLIC_FF_POSITION_DEBUG_PANEL=true
# For dev/QA testing, but not gated on import.meta.env.DEV: it ships to production when set.
# Forces partial liquidation split to always be suggested, even when the user has active vaults.
# NEXT_PUBLIC_FF_FORCE_PARTIAL_LIQUIDATION_SPLIT=true
# Freeze: shows the teal "Protocol is frozen" banner and disables new deposits + borrows (exits like repay/withdraw/liquidation stay available).
# NEXT_PUBLIC_FF_PROTOCOL_FROZEN=true
# Pause: shows the red "Protocol is paused" banner — the full stop. Wins over frozen when both are set.
# NEXT_PUBLIC_FF_PROTOCOL_PAUSED=true
# The single operator message shown to depositors, placed by context: it fills
# the frozen/paused status-card body when a status is active, fills the
# deposit-disabled banner text when deposits are off, or shows as a standalone
# top-of-app notice when nothing is disabled (e.g. intermittent peg-in errors
# while deposits stay on). Leave blank to use the default per-context copy.
# NEXT_PUBLIC_NOTICE_BANNER_MESSAGE=Peg-ins may be intermittently delayed. Retrying usually resolves it.
# Comma-separated list of BTC wallet IDs to hide from the connect UI, per
# environment. Use it to keep experimental/not-yet-ready wallets out (onekey,
# utila) and to pull a wallet fast if its signing behavior regresses. Any
# environment where an experimental wallet should stay hidden must list it here.
# IDs: unisat, onekey, okx, keystone, utila.
# NEXT_PUBLIC_TBV_DISABLED_BTC_WALLETS=onekey,utila

# Reveals the Ledger vault wallet (ledger_btc_vault) in the connect UI. This is
# Ledger's dedicated vault app over the DMK, NOT the legacy ledger_btc staking
# adapters. Hidden unless this is explicitly "true". The full deposit flow
# (pairing, DERIVE_CONTEXT_HASH, APPROVE_VAULT_INTENT, Pre-PegIn and payout
# signing) runs against the device (reclaim of the depositor-claim reserve is
# blocked on this wallet — see src/models/reclaimEligibility.ts); its firmware
# is still in review —
# so this is a per-environment opt-in, set via the deployment's GitHub
# environment variable. Requires desktop Chromium and a secure context (WebHID);
# the entry is hidden in browsers without navigator.hid regardless of this flag.
# NEXT_PUBLIC_FF_ENABLE_LEDGER_VAULT_WALLET=true
